
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #202938;
    font-family: Arial, sans-serif;
    padding: 15px;
}

.calculadora {
    width: 310px;
    max-width: 100%;
    padding: 20px;
    background: #111827;
    border-radius: 16px;
    box-shadow: 0 10px 30px #0005;
}

h1 {
    color: white;
    text-align: center;
    font-size: 24px;
}

#visor {
    width: 100%;
    height: 60px;
    margin-bottom: 12px;
    padding: 10px;
    border: none;
    border-radius: 8px;
    background: #e5e7eb;
    color: #111827;
    text-align: right;
    font-size: 28px;
}

.botoes {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
}

button {
    min-width: 0;
    padding: 16px 4px;
    border: none;
    border-radius: 8px;
    background: #374151;
    color: white;
    font-size: 20px;
    cursor: pointer;
}

button:hover {
    background: #526176;
}

.especial {
    background: #64748b;
}

.operador {
    background: #0d9488;
}

.igual {
    background: #22c55e;
    color: #102018;
}

button:active {
    transform: scale(0.96);
}